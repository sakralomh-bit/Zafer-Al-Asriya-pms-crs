APP_NAME="Zafer Al-Asriya PMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Synthetic development credentials only. Never a production secret.
# Real secrets are supplied by a central secret manager (SEC-005).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zafer_pms
DB_USERNAME=zafer
DB_PASSWORD=dev_only_synthetic_pw

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Money configuration (ADR-0006).
#
# `rounding_policy` is INTENTIONALLY EMPTY.
#
# Blocker C-04 (VAT inclusive/exclusive, rounding stage, rounding mode, storage
# precision and scale) is NOT CONFIRMED as of 2026-09-27. There is therefore no
# default rounding policy. A rounding operation that does not receive an
# explicit policy fails with MoneyRoundingPolicyNotConfigured. Do not fill this
# in without the finance/compliance owner's written decision — see
# docs/BLOCKER-STATUS.md and docs/ADR/0006-money-representation-bcmath-decimal.md.
# ---------------------------------------------------------------------------
MONEY_ROUNDING_POLICY=
MONEY_CALCULATION_SCALE=10
