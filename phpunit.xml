<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Security">
            <directory>tests/Security</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!--
            EXACTLY 32 bytes, base64-encoded. The previous value decoded to 33 and
            `Illuminate\Encryption\Encrypter` rejected it with "Unsupported cipher or
            incorrect key length" — but nothing noticed, because no test used a
            cookie. `EncryptCookies` only runs inside the `web` middleware group, and
            until the authentication routes existed no test reached it.

            So the defect was invisible locally AND on CI: 359 green tests never
            started a session over HTTP. The first route that does surfaced it.

            `aes-256-cbc` accepts 16, 24, or 32 bytes only. A test key is a fixture
            and this is not a secret — it is committed, it is for the test database,
            and it is regenerated here rather than treated as a credential.
        -->
        <env name="APP_KEY" value="base64:APKlwcgM9aCKf1473uPbcoIRUsn3iW34Tv76oCo+/Ko="/>
        <env name="APP_DEBUG" value="false"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="zafer_pms_test"/>
        <env name="DB_USERNAME" value="zafer"/>
        <env name="DB_PASSWORD" value="dev_only_synthetic_pw"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="LOG_CHANNEL" value="null"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
